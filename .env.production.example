APP_NAME="Bacco Sales API"
APP_ENV=production
APP_KEY=base64:OGth0tQGzl4SbKoBe4rHAu8UGossysxfmJmw/dsdQnk=
APP_DEBUG=false
APP_URL=https://api-bacco.phoenixtech.web.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Database (Diisi sesuai service MySQL di Coolify)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_bacco_sales_track_app
DB_USERNAME=root
DB_PASSWORD=

# Session, Cache & Queue via Redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Redis (Diisi sesuai service Redis di Coolify)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Object Storage S3 (Neva Objects)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=IEGGKPLA14XPJHR2AZZV
AWS_SECRET_ACCESS_KEY=1gabnDE08W1VoeLfXuVEkzPx6J4aXbQp7HLJJcgY
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=huntr-dev
AWS_ENDPOINT=https://s3.nevaobjects.id
AWS_USE_PATH_STYLE_ENDPOINT=true

# Otomatis migrate saat container startup (true / false)
RUN_MIGRATIONS=true
